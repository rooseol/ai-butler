<?xml version="1.0" encoding="utf-8"?>
<!--
  개인용 홈 서버(집 Wi-Fi의 PC)와 평문 HTTP/WS로 통신하기 위한 설정입니다.
  Android 9(API 28)부터 기본적으로 cleartext(HTTP) 트래픽이 차단되므로 명시적으로 허용합니다.
  외부망에서 접속할 계획이라면 Tailscale 등으로 터널링하거나 HTTPS 리버스 프록시를 두는 것을 권장합니다
  (docs/ARCHITECTURE.md 참고).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
