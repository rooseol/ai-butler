# 서버 포트
PORT=8787

# 각 CLI 실행 커맨드 (PATH에 있으면 이름만, 아니면 전체 경로)
#
# Windows에서는 CLAUDE_CMD를 반드시 claude.cmd가 아니라 그 안에서 실제로 실행되는
# claude.exe로 직접 지정하는 걸 강력히 권장합니다. claude.cmd(셸 배치 래퍼)로 실행하면
# Node가 cmd.exe를 한 번 더 거쳐 spawn하는데, 이 서버는 프롬프트를 stdin으로 흘려보내며
# (개행이 있어도 안전하게 전달하기 위함) — cmd.exe를 거치면 그 stdin EOF가 실제 claude.exe까지
# 제대로 전달되지 않아 요청이 응답 없이 멈추는(hang) 문제가 있었습니다.
# claude.cmd의 실제 위치는 보통 %APPDATA%\npm\claude.cmd 이고, 그 안에 적힌
# "...\node_modules\@anthropic-ai\claude-code\bin\claude.exe" 경로를 그대로 쓰면 됩니다.
# 예: CLAUDE_CMD=C:\Users\<사용자명>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
CLAUDE_CMD=claude
CODEX_CMD=codex
GEMINI_CMD=gemini

# 에이전트가 작업할 기본 작업 디렉터리 (CLI가 파일을 읽고 쓸 프로젝트 폴더)
# 예: Windows C:\Users\me\projects, macOS/Linux /home/me/projects
AGENT_WORKDIR=.

# 파일 저장 경로
STORAGE_DIR=./storage/files

# 헤드리스(-p) 모드는 대화형 터미널이 없어 "파일을 수정해도 될까요?" 같은 권한 프롬프트에 답할 수 없습니다.
# 기본값(true)은 --dangerously-skip-permissions로 자동 승인해, 파일 수정/명령 실행이 멈추지 않게 합니다.
# 이 서버는 페어링 토큰으로만 접근 가능한 개인용이라 기본 켜짐이 실용적이지만, 더 보수적으로 쓰고 싶으면 false로 두세요
# (단, false로 두면 도구를 쓰는 요청은 응답이 멈춘 것처럼 보일 수 있습니다 — 승인할 방법이 없기 때문입니다).
AGENT_SKIP_PERMISSIONS=true

# 에이전트 응답 제한시간(ms). 이 시간 안에 안 끝나면 프로세스를 강제 종료하고 에러로 알립니다
# (기본 10분 = 600000). CLI가 무슨 이유로든 멈춰버려도 폰에서 무한정 기다리지 않게 하는 안전장치입니다.
AGENT_TIMEOUT_MS=600000

# 페어링 토큰은 최초 실행 시 자동 생성되어 data/pairing.json 에 저장됩니다.
# 강제로 재발급하려면 이 파일을 지우고 서버를 재시작하세요.
